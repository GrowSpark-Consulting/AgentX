# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Patterns below are unanchored so they match in every workspace (frontend/, backend/, packages/*).
# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real values live in Vercel and the password manager, never in git
.env*
!.env.example

# supabase cli
supabase/.temp
supabase/.branches

# inngest dev server
.inngest

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
