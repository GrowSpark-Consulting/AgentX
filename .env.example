# Copy to frontend/.env.local for local development (Next.js reads env files from the
# app's own folder, not the repo root). Real values live in Vercel and the
# shared password manager (vault "Pakka Agent", one folder per environment).
# Never commit a filled-in copy. Empty means unset.

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000                 # staging: https://staging.pakkaagent.in · prod: https://app.pakkaagent.in

# Development only: show the dashboard shell (empty states, no business data) to a signed-in account
# that has no business yet, instead of the "not linked to a business" screen. Always on under
# `pnpm dev`; "true" turns it on for a production build. Never applies on Vercel production.
DEV_DASHBOARD_WITHOUT_TENANT=

# --- Supabase -----------------------------------------------------------------
# Local values come from `pnpm db:status` after `pnpm db:start`
# (API URL, Publishable/anon key, Secret/service_role key).
# NEXT_PUBLIC_SUPABASE_URL is the project API URL (https://<ref>.supabase.co), never the Postgres
# connection string: NEXT_PUBLIC_* values can reach the browser. Sign-in and /dashboard fail with an
# error naming the variable if it is anything else.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                                # server only, bypasses RLS
# "Continue with Google" sign-in, read by the Supabase CLI for local Auth (supabase/config.toml,
# [auth.external.google]); the app never reads them. Staging/prod set Google in the Supabase dashboard.
# Separate from GOOGLE_CLIENT_ID/SECRET below, which are Google Calendar's.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# --- LLM and embeddings -------------------------------------------------------
ANTHROPIC_API_KEY=                                        # one key per environment
EMBEDDINGS_API_KEY=                                       # provider chosen at kickoff

# --- Meta / WhatsApp Cloud API ------------------------------------------------
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=                                          # verifies webhook signatures, exchanges ES codes
NEXT_PUBLIC_META_ES_CONFIG_ID=                            # Facebook Login for Business configuration id
META_GRAPH_API_VERSION=                                   # pin one version (e.g. v23.0), upgrade deliberately
META_WEBHOOK_VERIFY_TOKEN=
META_SYSTEM_USER_TOKEN=                                   # our own portfolio only: demo number, template admin
WHATSAPP_DEMO_WABA_ID=
WHATSAPP_DEMO_PHONE_NUMBER_ID=
WHATSAPP_REGISTER_PIN=                                    # 6-digit two-step PIN used when registering numbers

# --- Google Calendar ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Razorpay -----------------------------------------------------------------
RAZORPAY_KEY_ID=                                          # rzp_test_... outside production
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Inngest ------------------------------------------------------------------
INNGEST_DEV=1                                             # local only: talk to `pnpm inngest:dev`; remove on Vercel
INNGEST_EVENT_KEY=                                        # staging/prod: set by the Inngest Vercel integration
INNGEST_SIGNING_KEY=

# --- Email, monitoring, tracing -----------------------------------------------
RESEND_API_KEY=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Crypto -------------------------------------------------------------------
ENCRYPTION_KEY=                                           # AES-256-GCM for tokens at rest: openssl rand -base64 32
